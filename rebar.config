{minimum_otp_vsn, "29"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec
]}.

{deps, [
    {nova, "0.18.1"},
    {arizona, {git, "https://github.com/arizona-framework/arizona.git", {branch, "main"}}},
    %% Serves the Arizona routes on Nova's listener (mounted mode).
    {arizona_cowboy,
        {git, "https://github.com/arizona-framework/arizona_cowboy.git", {branch, "feat/mount"}}}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{dialyzer, [
    {plt_apps, all_deps},
    {plt_extra_apps, [
        arizona,
        arizona_cowboy,
        nova,
        cowboy,
        cowlib,
        ranch
    ]},
    {warnings, [
        unknown,
        unmatched_returns
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [
            debug_info,
            nowarn_missing_spec,
            warnings_as_errors
        ]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_checks, []}
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{cover_enabled, true}.

{project_plugins, [
    covertool,
    rebar3_audit,
    rebar3_sbom,
    {erlfmt, "1.8.0"},
    {rebar3_hex, "~> 7.0"},
    {rebar3_ex_doc, "~> 0.2"}
]}.

{ex_doc, [
    {source_url, ~"https://github.com/arizona-framework/arizona_nova"},
    {extras, [~"README.md", ~"LICENSE"]},
    {main, ~"readme"},
    {proglang, erlang},
    {api_reference, true}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.app.src",
        "src/**/*.erl",
        "test/**/*.erl"
    ]}
]}.
