{application, arizona_nova, [
    {description, "Arizona on the Nova web framework"},
    {vsn, "git"},
    {registered, [arizona_nova_sup]},
    {mod, {arizona_nova_app, []}},
    {applications, [
        kernel,
        stdlib,
        nova,
        arizona,
        arizona_cowboy
    ]},
    {env, []},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [
        {"GitHub", "https://github.com/arizona-framework/arizona_nova"},
        {"Arizona", "https://github.com/arizona-framework/arizona"},
        {"Nova", "https://github.com/novaframework/nova"}
    ]}
]}.
