[
    {kernel, [{logger_level, notice}]},
    {nova, [
        {environment, dev},
        {bootstrap_application, example},
        {cowboy_configuration, #{
            port => 8080,
            %% `arizona_nova:middlewares()`, spelled out: a config file holds
            %% terms, not calls. Arizona's middleware first, then Nova's chain.
            middleware_handlers => [
                arizona_cowboy_middleware,
                nova_router,
                nova_plugin_handler,
                nova_security_handler,
                nova_handler,
                nova_plugin_handler
            ]
        }}
    ]},
    {arizona_nova, [
        {routes, [
            {live, <<"/">>, example_counter, #{layouts => [{example_layout, render}]}},
            {ws, <<"/ws">>, #{}},
            {asset, <<"/assets">>, {priv_dir, arizona, "static/assets/js"}}
        ]}
    ]}
].
