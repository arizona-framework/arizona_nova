{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% `arizona_nova` follows its `main`; `make` in this directory links the
%% checkout around it in through `_checkouts` instead, so the example always
%% runs the integration it sits beside.
{deps, [
    {nova, "0.18.1"},
    arizona,
    arizona_cowboy,
    arizona_nova
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [example]}
]}.

{ct_opts, [{sys_config, ["config/sys.config"]}]}.

{erlfmt, [
    write,
    {files, ["rebar.config", "config/*.config", "src/*.app.src", "src/**/*.erl", "test/**/*.erl"]}
]}.

{project_plugins, [{erlfmt, "1.8.0"}]}.
